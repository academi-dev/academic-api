# ==============================================================================
# Configuración del Entorno - Academic API
# ==============================================================================

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_db

# Clave secreta para la firma de tokens JWT (generar una segura en producción)
SECRET_KEY=tu_clave_secreta_super_segura_cambiala_en_produccion_min_32_caracteres

# Algoritmo de cifrado JWT
ALGORITHM=HS256

# Tiempo de expiración del token de acceso (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tiempo de expiración del token de actualización (en días)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno de ejecución: development, staging, production
ENVIRONMENT=development
